            background: #f0f5ff;
            color: #1d4ed8;
            font-size: 0.75rem;
            font-weight: 500;
            padding: 0.2rem 0.8rem;
            border-radius: 30px;
            margin-top: 0.2rem;
            margin-bottom: 0.7rem;
            border: 1px solid #bdd3ff;
