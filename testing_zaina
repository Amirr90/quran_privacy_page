            font-weight: 700;
            color: #1f3a6b;
            margin: 0.5rem 0 0.8rem;
        }

        .product-price small {
            font-size: 0.9rem;
            font-weight: 400;
            color: #64748b;
        }

        .fake-rating {
            color: #f5b342;
            font-size: 1rem;
            letter-spacing: 2px;
            margin-bottom: 1.1rem;
            background: #f8f9fc;
            padding: 0.2rem 0.8rem;
            border-radius: 30px;
            display: inline-block;
        }

